// Stella Chart: 静的ファイルを配信するだけの Worker（プログラムは持たない）。
// deploy は `npx wrangler deploy`（とむの確認を取ってから）。account_id は書かない（wrangler login のアカウントを使う）
{
  "name": "stella",
  "compatibility_date": "2026-11-01",
  // 入口はカスタムドメイン 1 つに絞る（書かないと deploy のたびに workers.dev / Preview URL が既定で有効になる）
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "stella.tomu-ai.dev", "custom_domain": true }],
  // 公開するファイルは tools/build-site.mjs の一覧で決める（README や設定ファイルを配信しない）。
  // wrangler dev / deploy の前に毎回走る
  "build": { "command": "node tools/build-site.mjs" },
  "assets": {
    "directory": "./dist/"
  }
}
